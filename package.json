{
	"name": "wp-excellent",
	"version": "3.0.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"description": "WP starter based on workflow for Cube CSS, Every Layout, Design Tokens and Tailwind for utility, based on the concepts explained in https://buildexcellentwebsit.es",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/madrilene/wp-excellent"
	},
	"text_domain": "wp-excellent",
	"keywords": [],
	"author": "Lene Saile",
	"author_uri": "https://www.lene.dev",
	"license": "MIT",
	"scripts": {
		"colors": "node _resources/utils/create-colors.js",
		"css": "mkdir -p dist/css && npx postcss _resources/css/global.css -o dist/css/global.css",
		"js": "esbuild --bundle _resources/js/*.js --outdir=dist/js --platform=browser --tree-shaking=true",
		"dev:blocks": "wp-scripts start _resources/blocks/index.js --output-path=dist/blocks",
		"build:blocks": "wp-scripts build _resources/blocks/index.js --output-path=dist/blocks",
		"browser-sync": "node _resources/utils/browser-sync-local.js",
		"start": "cross-env NODE_ENV=development concurrently 'npm run browser-sync' 'npm run css -- --watch' 'npm run js -- --watch' 'npm run dev:blocks'",
		"production": "cross-env NODE_ENV=production concurrently 'npm run css' 'npm run js -- --minify' 'npm run build:blocks'"
	},
	"dependencies": {
		"colorjs.io": "^0.7.1",
		"tailwindcss": "^3.4.17"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^28.2.0",
		"@wordpress/scripts": "^30.27.0",
		"autoprefixer": "^10.7.0",
		"browser-sync": "^3.0.4",
		"concurrently": "^10.0.7",
		"cross-env": "^10.1.0",
		"cssnano": "^9.9.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"postcss": "^8.5.33",
		"postcss-cli": "^12.0.0",
		"postcss-import": "^17.0.1",
		"postcss-js": "^5.1.1",
		"slugify": "^1.6.9"
	}
}
